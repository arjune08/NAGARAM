# NAGARAM environment variables
# Never commit private database passwords or secret keys.

# Supabase Auth (publishable key is safe for client authentication flows; keep overrides in Vercel/local envs)
SUPABASE_URL=https://kawujopsewnjbwinkccq.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional persistent Postgres connection for Flask-SQLAlchemy workspace data.
# Use your Supabase pooled/direct connection string with sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

SECRET_KEY=replace-with-a-long-random-secret
PERSISTENT_LOGIN_DAYS=30
