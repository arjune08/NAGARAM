# Local development / Vercel Environment Variables
# Never commit real credentials to GitHub.

# Supabase PostgreSQL connection string from the Supabase dashboard.
# Keep sslmode=require for hosted deployments.
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# DATABASE_URL is also supported for platform compatibility.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

SECRET_KEY=replace-with-a-long-random-secret
